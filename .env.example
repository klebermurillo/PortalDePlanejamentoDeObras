PORT=3000
NODE_ENV=development
TRUST_PROXY_HOPS=0
REPORT_TTL_SECONDS=60
REPORT_OUTPUT_DIR=tmp/relatorios
SESSION_TTL_SECONDS=28800

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=portal_obras
